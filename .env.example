# MONGODB_URI - Your MongoDB connection string
# Example: MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/taskarena
MONGODB_URI=

# NEXTAUTH_SECRET - Used for signing next-auth cookies/jwt
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# NEXTAUTH_URL - Canonical application URL
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (Optional)
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary Profile Image Uploads (Optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
